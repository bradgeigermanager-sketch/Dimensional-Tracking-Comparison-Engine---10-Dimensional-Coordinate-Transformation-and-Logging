# 2. **Procedure Logic**

```sql
DECLARE
    -- Raw 10D state
    v_x DOUBLE PRECISION;
    v_y DOUBLE PRECISION;
    v_z DOUBLE PRECISION;
    v_w DOUBLE PRECISION;
    v_v DOUBLE PRECISION;
    v_u DOUBLE PRECISION;
    v_q DOUBLE PRECISION;
    v_p DOUBLE PRECISION;
    v_s DOUBLE PRECISION;
    v_f DOUBLE PRECISION;

    v_state DOUBLE PRECISION[];

    -- Entanglement rows
    r_bond RECORD;

    -- Recursion limit
    v_max_recursion INTEGER := 1;
    v_recursion_count INTEGER := 0;

    -- DecaMatrix
    v_matrix DOUBLE PRECISION[];

    -- Augmented vector
    v_aug DOUBLE PRECISION[];
    v_new_aug DOUBLE PRECISION[];

    -- View manifold
    v_active_axes TEXT[];
    v_target_dims INTEGER;

    -- Metadata
    v_invisible TEXT[];
    v_visible_vals DOUBLE PRECISION[];
    v_metadata_vals DOUBLE PRECISION[];

BEGIN
    ----------------------------------------------------------------------
    -- 1. Load current 10D state
    ----------------------------------------------------------------------
    SELECT x,y,z,w,v,u,q,p,s,f,state_vector
    INTO v_x,v_y,v_z,v_w,v_v,v_u,v_q,v_p,v_s,v_f,v_state
    FROM ten_d_nodes
    WHERE id = in_node_id;

    ----------------------------------------------------------------------
    -- 2. Apply entanglement (PROC‑048) with recursion limit (PROC‑049)
    ----------------------------------------------------------------------
    FOR r_bond IN
        SELECT * FROM entanglement_bonds WHERE node_id = in_node_id
    LOOP
        EXIT WHEN v_recursion_count >= v_max_recursion;

        IF r_bond.source_dim = in_delta_axis THEN
            v_recursion_count := v_recursion_count + 1;

            CASE r_bond.target_dim
                WHEN 'x' THEN v_x := v_x + in_delta_value * r_bond.ratio;
                WHEN 'y' THEN v_y := v_y + in_delta_value * r_bond.ratio;
                WHEN 'z' THEN v_z := v_z + in_delta_value * r_bond.ratio;
                WHEN 'w' THEN v_w := v_w + in_delta_value * r_bond.ratio;
                WHEN 'v' THEN v_v := v_v + in_delta_value * r_bond.ratio;
                WHEN 'u' THEN v_u := v_u + in_delta_value * r_bond.ratio;
                WHEN 'q' THEN v_q := v_q + in_delta_value * r_bond.ratio;
                WHEN 'p' THEN v_p := v_p + in_delta_value * r_bond.ratio;
                WHEN 's' THEN v_s := v_s + in_delta_value * r_bond.ratio;
                WHEN 'f' THEN v_f := v_f + in_delta_value * r_bond.ratio;
            END CASE;
        END IF;
    END LOOP;

    ----------------------------------------------------------------------
    -- 3. Load DecaMatrix (11×11)
    ----------------------------------------------------------------------
    SELECT matrix INTO v_matrix
    FROM decamatrix_transforms
    WHERE node_id = in_node_id;

    ----------------------------------------------------------------------
    -- 4. Build augmented vector [x..f, 1.0]
    ----------------------------------------------------------------------
    v_aug := ARRAY[v_x,v_y,v_z,v_w,v_v,v_u,v_q,v_p,v_s,v_f,1.0];

    ----------------------------------------------------------------------
    -- 5. Multiply by 11×11 matrix
    ----------------------------------------------------------------------
    v_new_aug := ARRAY[
        -- Row 1
        v_matrix[1]*v_aug[1] + v_matrix[2]*v_aug[2] + v_matrix[3]*v_aug[3] +
        v_matrix[4]*v_aug[4] + v_matrix[5]*v_aug[5] + v_matrix[6]*v_aug[6] +
        v_matrix[7]*v_aug[7] + v_matrix[8]*v_aug[8] + v_matrix[9]*v_aug[9] +
        v_matrix[10]*v_aug[10] + v_matrix[11]*v_aug[11],

        -- Row 2
        v_matrix[12]*v_aug[1] + v_matrix[13]*v_aug[2] + v_matrix[14]*v_aug[3] +
        v_matrix[15]*v_aug[4] + v_matrix[16]*v_aug[5] + v_matrix[17]*v_aug[6] +
        v_matrix[18]*v_aug[7] + v_matrix[19]*v_aug[8] + v_matrix[20]*v_aug[9] +
        v_matrix[21]*v_aug[10] + v_matrix[22]*v_aug[11],

        -- ... rows 3–10 omitted for brevity ...

        -- Row 11
        v_matrix[111]*v_aug[1] + v_matrix[112]*v_aug[2] + v_matrix[113]*v_aug[3] +
        v_matrix[114]*v_aug[4] + v_matrix[115]*v_aug[5] + v_matrix[116]*v_aug[6] +
        v_matrix[117]*v_aug[7] + v_matrix[118]*v_aug[8] + v_matrix[119]*v_aug[9] +
        v_matrix[120]*v_aug[10] + v_matrix[121]*v_aug[11]
    ];

    ----------------------------------------------------------------------
    -- 6. Extract transformed 10D vector
    ----------------------------------------------------------------------
    v_state := v_new_aug[1:10];

    ----------------------------------------------------------------------
    -- 7. Load view manifold (PROC‑044 / PROC‑045)
    ----------------------------------------------------------------------
    SELECT active_axes, projection_target_dims
    INTO v_active_axes, v_target_dims
    FROM view_manifolds
    WHERE node_id = in_node_id;

    ----------------------------------------------------------------------
    -- 8. Compute visible vs invisible dimensions
    ----------------------------------------------------------------------
    v_invisible := ARRAY(
        SELECT unnest(ARRAY['x','y','z','w','v','u','q','p','s','f'])
        EXCEPT SELECT unnest(v_active_axes)
    );

    v_visible_vals := ARRAY(
        SELECT v_state[
            CASE axis
                WHEN 'x' THEN 1
                WHEN 'y' THEN 2
                WHEN 'z' THEN 3
                WHEN 'w' THEN 4
                WHEN 'v' THEN 5
                WHEN 'u' THEN 6
                WHEN 'q' THEN 7
                WHEN 'p' THEN 8
                WHEN 's' THEN 9
                WHEN 'f' THEN 10
            END
        ]
        FROM unnest(v_active_axes) AS axis
    );

    v_metadata_vals := ARRAY(
        SELECT v_state[
            CASE axis
                WHEN 'x' THEN 1
                WHEN 'y' THEN 2
                WHEN 'z' THEN 3
                WHEN 'w' THEN 4
                WHEN 'v' THEN 5
                WHEN 'u' THEN 6
                WHEN 'q' THEN 7
                WHEN 'p' THEN 8
                WHEN 's' THEN 9
                WHEN 'f' THEN 10
            END
        ]
        FROM unnest(v_invisible) AS axis
    );

    ----------------------------------------------------------------------
    -- 9. Update node state
    ----------------------------------------------------------------------
    UPDATE ten_d_nodes
    SET
        x = v_state[1],
        y = v_state[2],
        z = v_state[3],
        w = v_state[4],
        v = v_state[5],
        u = v_state[6],
        q = v_state[7],
        p = v_state[8],
        s = v_state[9],
        f = v_state[10],
        state_vector = v_state,
        last_delta_axis = in_delta_axis,
        last_delta_value = in_delta_value
    WHERE id = in_node_id;

    ----------------------------------------------------------------------
    -- 10. Update metadata cache (PROC‑046)
    ----------------------------------------------------------------------
    INSERT INTO metadata_cache (node_id, invisible_dims, full_vector)
    VALUES (in_node_id, v_invisible, v_state)
    ON CONFLICT (node_id)
    DO UPDATE SET invisible_dims = EXCLUDED.invisible_dims,
                  full_vector = EXCLUDED.full_vector;

    ----------------------------------------------------------------------
    -- 11. Return visible manifold + metadata
    ----------------------------------------------------------------------
    RETURN jsonb_build_object(
        'visible_axes', v_active_axes,
        'visible_values', v_visible_vals,
        'metadata_axes', v_invisible,
        'metadata_values', v_metadata_vals,
        'full_vector', v_state
    );

END;
$$;
```

