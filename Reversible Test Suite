## **1. test_reversible_single_step.py**

```python
import numpy as np
from engine.transform import TransformEngine
from models.node import TenDNode
from models.schema import schema

MAX_ERR = schema["reversibility"]["max_reversible_error"]

def random_node():
    return TenDNode(
        state_vector=np.random.randn(10).tolist(),
        decamatrix=np.random.randn(121).tolist(),
        entanglement=[],
        metadata={}
    )

def test_reversible_single_step():
    node = random_node()

    # Forward
    forward_state, _ = TransformEngine.forward(node)

    # Inverse
    recovered_state = TransformEngine.inverse(
        node.copy(update={"state_vector": forward_state})
    )

    # Compute reversible error
    err = np.linalg.norm(np.array(recovered_state) - np.array(node.state_vector))

    assert err <= MAX_ERR, f"Reversible error too high: {err}"
```

This enforces the **hard bound**.

