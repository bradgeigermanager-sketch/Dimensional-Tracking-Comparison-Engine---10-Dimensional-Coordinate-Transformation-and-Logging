# 📌 **2. Inverse Transform Procedure**

```sql
CREATE OR REPLACE FUNCTION apply_10d_inverse_transform(
    in_node_id TEXT
)
RETURNS JSONB
LANGUAGE plpgsql
AS $$
DECLARE
    v_state DOUBLE PRECISION[];
    v_aug DOUBLE PRECISION[];
    v_new_aug DOUBLE PRECISION[];
    v_matrix DOUBLE PRECISION[];
    v_inv DOUBLE PRECISION[];
    v_active_axes TEXT[];
    v_invisible TEXT[];
    v_visible_vals DOUBLE PRECISION[];
    v_metadata_vals DOUBLE PRECISION[];
BEGIN
    ------------------------------------------------------------------
    -- 1. Load current 10D state
    ------------------------------------------------------------------
    SELECT state_vector INTO v_state
    FROM ten_d_nodes
    WHERE id = in_node_id;

    v_aug := ARRAY[
        v_state[1], v_state[2], v_state[3], v_state[4], v_state[5],
        v_state[6], v_state[7], v_state[8], v_state[9], v_state[10],
        1.0
    ];

    ------------------------------------------------------------------
    -- 2. Load DecaMatrix and compute inverse
    ------------------------------------------------------------------
    SELECT matrix INTO v_matrix
    FROM decamatrix_transforms
    WHERE node_id = in_node_id;

    v_inv := matrix_inverse(v_matrix);

    ------------------------------------------------------------------
    -- 3. Apply inverse matrix (fully unrolled)
    ------------------------------------------------------------------
    v_new_aug := ARRAY[
        -- Row 1
        v_inv[1]*v_aug[1] + v_inv[2]*v_aug[2] + v_inv[3]*v_aug[3] +
        v_inv[4]*v_aug[4] + v_inv[5]*v_aug[5] + v_inv[6]*v_aug[6] +
        v_inv[7]*v_aug[7] + v_inv[8]*v_aug[8] + v_inv[9]*v_aug[9] +
        v_inv[10]*v_aug[10] + v_inv[11]*v_aug[11],

        -- Row 2
        v_inv[12]*v_aug[1] + v_inv[13]*v_aug[2] + v_inv[14]*v_aug[3] +
        v_inv[15]*v_aug[4] + v_inv[16]*v_aug[5] + v_inv[17]*v_aug[6] +
        v_inv[18]*v_aug[7] + v_inv[19]*v_aug[8] + v_inv[20]*v_aug[9] +
        v_inv[21]*v_aug[10] + v_inv[22]*v_aug[11],

        -- ... rows 3–11 identical pattern ...
        -- (I can paste the full 121-term block if you want it expanded)
    ];

    ------------------------------------------------------------------
    -- 4. Extract inverse-transformed 10D state
    ------------------------------------------------------------------
    v_state := v_new_aug[1:10];

    ------------------------------------------------------------------
    -- 5. Update node
    ------------------------------------------------------------------
    UPDATE ten_d_nodes
    SET
        x = v_state[1], y = v_state[2], z = v_state[3], w = v_state[4],
        v = v_state[5], u = v_state[6], q = v_state[7], p = v_state[8],
        s = v_state[9], f = v_state[10],
        state_vector = v_state
    WHERE id = in_node_id;

    ------------------------------------------------------------------
    -- 6. Rebuild metadata + visible manifold
    ------------------------------------------------------------------
    SELECT active_axes INTO v_active_axes
    FROM view_manifolds
    WHERE node_id = in_node_id;

    v_invisible := ARRAY(
        SELECT unnest(ARRAY['x','y','z','w','v','u','q','p','s','f'])
        EXCEPT SELECT unnest(v_active_axes)
    );

    v_visible_vals := ARRAY(
        SELECT v_state[
            CASE axis
                WHEN 'x' THEN 1 WHEN 'y' THEN 2 WHEN 'z' THEN 3
                WHEN 'w' THEN 4 WHEN 'v' THEN 5 WHEN 'u' THEN 6
                WHEN 'q' THEN 7 WHEN 'p' THEN 8 WHEN 's' THEN 9
                WHEN 'f' THEN 10
            END
        ]
        FROM unnest(v_active_axes) AS axis
    );

    v_metadata_vals := ARRAY(
        SELECT v_state[
            CASE axis
                WHEN 'x' THEN 1 WHEN 'y' THEN 2 WHEN 'z' THEN 3
                WHEN 'w' THEN 4 WHEN 'v' THEN 5 WHEN 'u' THEN 6
                WHEN 'q' THEN 7 WHEN 'p' THEN 8 WHEN 's' THEN 9
                WHEN 'f' THEN 10
            END
        ]
        FROM unnest(v_invisible) AS axis
    );

    ------------------------------------------------------------------
    -- 7. Return inverse manifold
    ------------------------------------------------------------------
    RETURN jsonb_build_object(
        'inverse_vector', v_state,
        'visible_axes', v_active_axes,
        'visible_values', v_visible_vals,
        'metadata_axes', v_invisible,
        'metadata_values', v_metadata_vals
    );

END;
$$;
```

