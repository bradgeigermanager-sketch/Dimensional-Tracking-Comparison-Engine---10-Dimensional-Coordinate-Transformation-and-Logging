### 3. Reversible execution trace (forward + inverse)

First, a trace table:

```sql
CREATE TABLE ten_d_traces (
    id              BIGSERIAL PRIMARY KEY,
    node_id         TEXT NOT NULL,
    direction       TEXT NOT NULL CHECK (direction IN ('forward','inverse')),
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    delta_axis      TEXT,
    delta_value     DOUBLE PRECISION,
    state_before    DOUBLE PRECISION[],
    state_after     DOUBLE PRECISION[],
    matrix_snapshot DOUBLE PRECISION[],
    entanglement_snapshot JSONB
);
```

Now a wrapper that runs forward, then inverse, and returns a full trace:

```sql
CREATE OR REPLACE FUNCTION run_10d_reversible_step(
    in_node_id TEXT,
    in_delta_axis TEXT,
    in_delta_value DOUBLE PRECISION
)
RETURNS JSONB
LANGUAGE plpgsql
AS $$
DECLARE
    v_before DOUBLE PRECISION[];
    v_after_forward DOUBLE PRECISION[];
    v_after_inverse DOUBLE PRECISION[];
    v_matrix DOUBLE PRECISION[];
    v_bonds JSONB;
    v_forward JSONB;
    v_inverse JSONB;
BEGIN
    -- snapshot before
    SELECT state_vector INTO v_before
    FROM ten_d_nodes
    WHERE id = in_node_id;

    SELECT matrix INTO v_matrix
    FROM decamatrix_transforms
    WHERE node_id = in_node_id;

    SELECT jsonb_agg(
               jsonb_build_object(
                   'source_dim', source_dim,
                   'target_dim', target_dim,
                   'ratio', ratio,
                   'type', type
               )
           )
    INTO v_bonds
    FROM entanglement_bonds
    WHERE node_id = in_node_id;

    -- forward
    v_forward := apply_10d_state_transform(in_node_id, in_delta_axis, in_delta_value);
    SELECT state_vector INTO v_after_forward
    FROM ten_d_nodes
    WHERE id = in_node_id;

    INSERT INTO ten_d_traces (
        node_id, direction, delta_axis, delta_value,
        state_before, state_after, matrix_snapshot, entanglement_snapshot
    ) VALUES (
        in_node_id, 'forward', in_delta_axis, in_delta_value,
        v_before, v_after_forward, v_matrix, v_bonds
    );

    -- inverse
    v_inverse := apply_10d_inverse_transform(in_node_id);
    SELECT state_vector INTO v_after_inverse
    FROM ten_d_nodes
    WHERE id = in_node_id;

    INSERT INTO ten_d_traces (
        node_id, direction,
        state_before, state_after, matrix_snapshot, entanglement_snapshot
    ) VALUES (
        in_node_id, 'inverse',
        v_after_forward, v_after_inverse, v_matrix, v_bonds
    );

    -- return full reversible trace
    RETURN jsonb_build_object(
        'node_id', in_node_id,
        'delta_axis', in_delta_axis,
        'delta_value', in_delta_value,
        'state_before', v_before,
        'state_after_forward', v_after_forward,
        'state_after_inverse', v_after_inverse,
        'forward_payload', v_forward,
        'inverse_payload', v_inverse
    );
END;
$$;
```

