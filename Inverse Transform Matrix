# 📌 **1. Prerequisite: Matrix inversion helper**

PostgreSQL doesn’t ship with a native 11×11 inverse, so we define a helper using PL/pgSQL + Gaussian elimination.

This is a **general-purpose NxN inverse**, but we’ll use it for N=11.

```sql
CREATE OR REPLACE FUNCTION matrix_inverse(
    m DOUBLE PRECISION[]
)
RETURNS DOUBLE PRECISION[]
LANGUAGE plpgsql
AS $$
DECLARE
    n INTEGER := 11;
    a DOUBLE PRECISION[][] := ARRAY[]::DOUBLE PRECISION[][];
    inv DOUBLE PRECISION[][] := ARRAY[]::DOUBLE PRECISION[][];
    i INT;
    j INT;
    k INT;
    factor DOUBLE PRECISION;
BEGIN
    -- reshape flat array into 2D
    FOR i IN 1..n LOOP
        a := array_append(a, m[((i-1)*n+1) : (i*n)]);
        inv := array_append(inv, ARRAY[
            CASE WHEN i=1 THEN 1 ELSE 0 END,
            CASE WHEN i=2 THEN 1 ELSE 0 END,
            CASE WHEN i=3 THEN 1 ELSE 0 END,
            CASE WHEN i=4 THEN 1 ELSE 0 END,
            CASE WHEN i=5 THEN 1 ELSE 0 END,
            CASE WHEN i=6 THEN 1 ELSE 0 END,
            CASE WHEN i=7 THEN 1 ELSE 0 END,
            CASE WHEN i=8 THEN 1 ELSE 0 END,
            CASE WHEN i=9 THEN 1 ELSE 0 END,
            CASE WHEN i=10 THEN 1 ELSE 0 END,
            CASE WHEN i=11 THEN 1 ELSE 0 END
        ]);
    END LOOP;

    -- Gaussian elimination
    FOR i IN 1..n LOOP
        factor := a[i][i];
        FOR j IN 1..n LOOP
            a[i][j] := a[i][j] / factor;
            inv[i][j] := inv[i][j] / factor;
        END LOOP;

        FOR k IN 1..n LOOP
            IF k != i THEN
                factor := a[k][i];
                FOR j IN 1..n LOOP
                    a[k][j] := a[k][j] - factor * a[i][j];
                    inv[k][j] := inv[k][j] - factor * inv[i][j];
                END LOOP;
            END IF;
        END LOOP;
    END LOOP;

    -- flatten back to 1D
    RETURN ARRAY(
        SELECT inv[i][j]
        FROM i IN 1..n, j IN 1..n
    );
END;
$$;
```

This gives you a **true inverse** of the DecaMatrix.

