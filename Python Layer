# 🧩 2. Python: 10D Engine Client

This wraps your SQL procedures:

```python
class TenDEngine:
    def __init__(self, dsn: str):
        self.dsn = dsn
        self.pool = None

    async def connect(self):
        self.pool = await asyncpg.create_pool(self.dsn)

    async def forward(self, node_id: str, axis: str, delta: float) -> Dict[str, Any]:
        async with self.pool.acquire() as conn:
            return await conn.fetchval(
                "SELECT apply_10d_state_transform($1,$2,$3)",
                node_id, axis, delta
            )

    async def inverse(self, node_id: str) -> Dict[str, Any]:
        async with self.pool.acquire() as conn:
            return await conn.fetchval(
                "SELECT apply_10d_inverse_transform($1)",
                node_id
            )

    async def reversible(self, node_id: str, axis: str, delta: float) -> Dict[str, Any]:
        async with self.pool.acquire() as conn:
            return await conn.fetchval(
                "SELECT run_10d_reversible_step($1,$2,$3)",
                node_id, axis, delta
            )

    async def get_state(self, node_id: str) -> TenDState:
        async with self.pool.acquire() as conn:
            vec = await conn.fetchval(
                "SELECT state_vector FROM ten_d_nodes WHERE id=$1",
                node_id
            )
        return TenDState.from_vector(vec)
