# 🧩 3. Python: NumPy Validation Layer  
This confirms that:

- PostgreSQL forward transform = NumPy forward  
- PostgreSQL inverse transform = NumPy inverse  
- inverse(forward(x)) ≈ x  

```python
class TenDValidator:
    def __init__(self, engine: TenDEngine):
        self.engine = engine

    @staticmethod
    def numpy_forward(vec: np.ndarray, matrix: np.ndarray) -> np.ndarray:
        aug = np.append(vec, 1.0)
        out = matrix @ aug
        return out[:10]

    @staticmethod
    def numpy_inverse(vec: np.ndarray, matrix: np.ndarray) -> np.ndarray:
        aug = np.append(vec, 1.0)
        inv = np.linalg.inv(matrix)
        out = inv @ aug
        return out[:10]

    async def validate(self, node_id: str, axis: str, delta: float):
        # 1. Get initial state
        before = (await self.engine.get_state(node_id)).to_vector()

        # 2. Run forward in DB
        await self.engine.forward(node_id, axis, delta)
        after_forward = (await self.engine.get_state(node_id)).to_vector()

        # 3. Run inverse in DB
        await self.engine.inverse(node_id)
        after_inverse = (await self.engine.get_state(node_id)).to_vector()

        # 4. Load matrix
        async with self.engine.pool.acquire() as conn:
            flat = await conn.fetchval(
                "SELECT matrix FROM decamatrix_transforms WHERE node_id=$1",
                node_id
            )
        matrix = np.array(flat).reshape(11, 11)

        # 5. NumPy forward/inverse
        np_forward = self.numpy_forward(before, matrix)
        np_inverse = self.numpy_inverse(np_forward, matrix)

        return {
            "before": before.tolist(),
            "db_forward": after_forward.tolist(),
            "np_forward": np_forward.tolist(),
            "db_inverse": after_inverse.tolist(),
            "np_inverse": np_inverse.tolist(),
            "inverse_error": float(np.linalg.norm(after_inverse - before)),
            "forward_error": float(np.linalg.norm(after_forward - np_forward)),
        }
```

