class DAMMSAdapter:
    def __init__(self, engine: TenDEngine):
        self.engine = engine

    async def apply(self, node_id: str, axis: str, delta: float):
        trace = await self.engine.reversible(node_id, axis, delta)
        return {
            "node": node_id,
            "delta": {"axis": axis, "value": delta},
            "forward": trace["forward_payload"],
            "inverse": trace["inverse_payload"],
            "restored": trace["state_after_inverse"],
        }

    async def classify_regime(self, node_id: str):
        """Simple chaos/stability classifier."""
        state = (await self.engine.get_state(node_id)).to_vector()
        energy = float(np.linalg.norm(state))

        if energy < 10:
            return "stable"
        if energy < 100:
            return "quasi-stable"
        return "chaotic"
