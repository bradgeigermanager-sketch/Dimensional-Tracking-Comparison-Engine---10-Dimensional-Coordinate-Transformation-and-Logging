# **1. TypeScript Implementation (Concrete)**  
This is ready to paste into your codebase.

```ts
export interface StepRecord {
  node_id: string;
  step_index: number;
  direction: "forward" | "inverse";

  timestamps: {
    created_at: string; // ISO 8601
  };

  state: {
    before: number[]; // length 10
    after: number[];  // length 10
  };

  inputs: {
    delta_axis: number | null;
    delta_value: number | null;
    matrix_snapshot: number[]; // length 121
    entanglement_snapshot: EntanglementBond[];
  };

  metrics: {
    duration_ms: number;
    matrix_condition: number;
    matrix_det: number;
    entanglement_count: number;
    state_norm_before: number;
    state_norm_after: number;
    reversible_error: number | null;
  };

  versions: {
    usm_schema_version: string;
    manifest_version: number;
    generator_version: string;
    engine_version: string;
  };
}

export interface EntanglementBond {
  source_dim: number;
  target_dim: number;
  ratio: number;
  type: "linear" | "inhibitory" | "excitatory" | "resonant";
}
```

