### `usm/engine/reversible_execution.py` (forward + inverse + error)

```python
from __future__ import annotations
import time
import numpy as np

from usm.core.models import TenDNode
from usm.core.logging_models import CoordinateLogEntry, MetricsLogEntry
from usm.engine.transform_engine import _apply_entanglement


def inverse_step(node: TenDNode) -> list[float]:
    x = np.array(node.state_vector, dtype=float)
    A = np.array(node.decamatrix, dtype=float).reshape(11, 11)
    A_inv = np.linalg.inv(A)

    x11 = np.concatenate([x, np.array([1.0])])
    x11_inv = A_inv @ x11
    x_inv = x11_inv[:10]
    x_inv_ent = _reverse_entanglement(x_inv, node)
    return x_inv_ent.tolist()


def _reverse_entanglement(x: np.ndarray, node: TenDNode) -> np.ndarray:
    # naive reverse: approximate by subtracting forward effect
    x_new = x.copy()
    for bond in node.entanglement:
        s, t, r, btype = bond.source_dim, bond.target_dim, bond.ratio, bond.type
        if btype == "excitatory":
            x_new[t] -= r * x[s]
        elif btype == "inhibitory":
            x_new[t] += r * x[s]
        elif btype == "resonant":
            x_new[t] -= r * np.sin(x[s])
    return x_new


def reversible_cycle(node_id: str, node: TenDNode, step_index: int):
    # forward already applied; treat node.state_vector as forward result
    start = time.time()
    x_forward = np.array(node.state_vector, dtype=float)

    x_recovered = np.array(inverse_step(node), dtype=float)
    duration_ms = (time.time() - start) * 1000.0

    error = float(np.linalg.norm(x_recovered - x_forward))

    coord_log = CoordinateLogEntry(
        node_id=node_id,
        step_index=step_index,
        direction="inverse",
        state_vector=x_recovered.tolist(),
        reversible_error=error,
    )

    metrics_log = MetricsLogEntry(
        node_id=node_id,
        step_index=step_index,
        duration_ms=duration_ms,
        matrix_condition=0.0,  # could recompute if desired
        matrix_det=0.0,
        entanglement_count=len(node.entanglement),
        entanglement_delta_sum=float(
            sum(abs(b.ratio) for b in node.entanglement)
        ),
        state_norm_before=float(np.linalg.norm(x_forward)),
        state_norm_after=float(np.linalg.norm(x_recovered)),
        reversible_error=error,
    )

    return coord_log, metrics_log
