### `usm/view/view_manifold.py` (manifold helpers)

```python
from __future__ import annotations
from typing import List
import numpy as np

from usm.core.models import TenDNode


def update_pca_2d(node: TenDNode, history: List[List[float]]) -> TenDNode:
    """
    Very minimal PCA-2D over history + current state.
    """
    X = np.array(history + [node.state_vector], dtype=float)
    Xc = X - X.mean(axis=0, keepdims=True)
    U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
    proj = (Xc @ Vt[:2].T)[-1]  # last point

    vm = node.view_manifold
    vm.projections["pca_2d"] = proj.tolist()
    return node.copy(update={"view_manifold": vm})
```

