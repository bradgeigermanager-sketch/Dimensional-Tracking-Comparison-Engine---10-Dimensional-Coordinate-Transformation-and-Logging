### `usm/engine/differential_analyzer.py` (Δ‑engine)

```python
from __future__ import annotations
from typing import List, Dict, Any
import numpy as np

from usm.core.logging_models import CoordinateLogEntry


def compute_differentials(coords: List[CoordinateLogEntry]) -> Dict[str, Any]:
    vecs = np.array([c.state_vector for c in coords], dtype=float)
    if len(vecs) < 2:
        return {
            "mean_delta_norm": 0.0,
            "max_delta_norm": 0.0,
            "per_dim_mean": [0.0] * 10,
            "per_dim_max_abs": [0.0] * 10,
        }

    deltas = vecs[1:] - vecs[:-1]
    delta_norms = np.linalg.norm(deltas, axis=1)

    return {
        "mean_delta_norm": float(delta_norms.mean()),
        "max_delta_norm": float(delta_norms.max()),
        "per_dim_mean": deltas.mean(axis=0).tolist(),
        "per_dim_max_abs": np.abs(deltas).max(axis=0).tolist(),
    }
```

