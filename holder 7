### `usm/engine/transform_engine.py` (core physics)

```python
from __future__ import annotations
from typing import Tuple
import time
import numpy as np

from usm.core.models import TenDNode
from usm.core.logging_models import (
    InputLogEntry,
    CoordinateLogEntry,
    MetricsLogEntry,
)


def _apply_entanglement(x: np.ndarray, node: TenDNode) -> np.ndarray:
    x_new = x.copy()
    for bond in node.entanglement:
        s, t, r, btype = bond.source_dim, bond.target_dim, bond.ratio, bond.type
        if btype == "excitatory":
            x_new[t] += r * x[s]
        elif btype == "inhibitory":
            x_new[t] -= r * x[s]
        elif btype == "resonant":
            x_new[t] += r * np.sin(x[s])
    return x_new


def forward_step(
    node_id: str,
    node: TenDNode,
    step_index: int,
    delta_axis: int | None = None,
    delta_value: float | None = None,
):
    start = time.time()

    x = np.array(node.state_vector, dtype=float)
    A = np.array(node.decamatrix, dtype=float).reshape(11, 11)

    # embed 10D into 11D (last dim = 1 for affine)
    x11 = np.concatenate([x, np.array([1.0])])
    x11_fwd = A @ x11
    x_fwd = x11_fwd[:10]

    x_ent = _apply_entanglement(x_fwd, node)

    state_before_norm = float(np.linalg.norm(x))
    state_after_norm = float(np.linalg.norm(x_ent))

    cond = float(np.linalg.cond(A))
    det = float(np.linalg.det(A))

    duration_ms = (time.time() - start) * 1000.0

    input_log = InputLogEntry(
        node_id=node_id,
        step_index=step_index,
        delta_axis=delta_axis,
        delta_value=delta_value,
        matrix_snapshot=node.decamatrix,
        entanglement_snapshot=[b.dict() for b in node.entanglement],
        metadata={"mode": "forward"},
    )

    coord_log = CoordinateLogEntry(
        node_id=node_id,
        step_index=step_index,
        direction="forward",
        state_vector=x_ent.tolist(),
        delta_axis=delta_axis,
        delta_value=delta_value,
    )

    metrics_log = MetricsLogEntry(
        node_id=node_id,
        step_index=step_index,
        duration_ms=duration_ms,
        matrix_condition=cond,
        matrix_det=det,
        entanglement_count=len(node.entanglement),
        entanglement_delta_sum=float(
            sum(abs(b.ratio) for b in node.entanglement)
        ),
        state_norm_before=state_before_norm,
        state_norm_after=state_after_norm,
        reversible_error=None,
    )

    node_next = node.copy(update={"state_vector": coord_log.state_vector})
    return node_next, input_log, coord_log, metrics_log
```

