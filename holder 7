### `usm/core/models.py` (TenDNode + bonds + manifold)

```python
from __future__ import annotations
from typing import List, Dict, Any
from pydantic import BaseModel, Field, validator


class EntanglementBond(BaseModel):
    source_dim: int
    target_dim: int
    ratio: float
    type: str = Field(..., regex="^(excitatory|inhibitory|resonant)$")


class ViewManifold(BaseModel):
    visible_dims: List[int]
    hidden_dims: List[int]
    labels: Dict[int, str]
    projections: Dict[str, List[float]]
    metadata: Dict[str, Any] = {}

    @validator("labels", pre=True)
    def _coerce_label_keys(cls, v):
        # allow string keys in JSON, convert to int
        return {int(k): val for k, val in v.items()}


class TenDNode(BaseModel):
    state_vector: List[float]
    decamatrix: List[float]
    entanglement: List[EntanglementBond]
    view_manifold: ViewManifold

    @validator("state_vector")
    def _check_state_vector(cls, v):
        if len(v) != 10:
            raise ValueError("state_vector must have length 10")
        return v

    @validator("decamatrix")
    def _check_decamatrix(cls, v):
        if len(v) != 121:
            raise ValueError("decamatrix must have length 121 (11x11 flattened)")
        return v
