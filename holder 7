### `usm/engine/replay_engine.py` (log‑driven reconstruction, simplified)

```python
from __future__ import annotations
from typing import List
import numpy as np

from usm.core.models import TenDNode
from usm.core.logging_models import InputLogEntry, CoordinateLogEntry


def replay_step(
    node: TenDNode,
    input_log: InputLogEntry,
    coord_log: CoordinateLogEntry,
) -> bool:
    """
    Recompute forward step from input_log and compare to coord_log.state_vector.
    Returns True if they match within tolerance.
    """
    x = np.array(node.state_vector, dtype=float)
    A = np.array(input_log.matrix_snapshot, dtype=float).reshape(11, 11)

    x11 = np.concatenate([x, np.array([1.0])])
    x11_fwd = A @ x11
    x_fwd = x11_fwd[:10]

    # naive entanglement reapply
    from usm.engine.transform_engine import _apply_entanglement

    node_tmp = node.copy(update={"entanglement": []})
    node_tmp.entanglement = [
        # rebuild bonds from snapshot
        # (we stored them as dicts)
        # pydantic model reconstruction:
        node_tmp.entanglement.__class__(**b)  # type: ignore
        for b in input_log.entanglement_snapshot
    ]
    x_ent = _apply_entanglement(x_fwd, node_tmp)

    diff = np.linalg.norm(x_ent - np.array(coord_log.state_vector, dtype=float))
    return bool(diff < 1e-6)
```

