### 2. Schema‑driven documentation generator (Markdown)

`generate_usm_docs.py`:

```python
import json
from pathlib import Path

SCHEMA_PATH = Path("usm_v1_schema.json")
OUT_MD = Path("USM_MANIFEST.md")


def title_from_key(key: str) -> str:
    return " ".join(part.capitalize() for part in key.split("_"))


def generate_markdown(schema):
    lines = []
    lines.append(f"# USM Manifest — {schema.get('title', 'USM')}")
    lines.append("")
    lines.append(schema.get("description", ""))
    lines.append("")

    for section_key, section_obj in schema.get("properties", {}).items():
        lines.append(f"## {title_from_key(section_key)}")
        lines.append("")
        props = section_obj.get("properties", {})
        if not props:
            lines.append("_No fields defined._")
            lines.append("")
            continue
        for field_key in props.keys():
            lines.append(f"- **{field_key}**")
        lines.append("")

    return "\n".join(lines)


def main():
    schema = json.loads(SCHEMA_PATH.read_text())
    md = generate_markdown(schema)
    OUT_MD.write_text(md)
    print(f"Wrote {OUT_MD}")


if __name__ == "__main__":
    main()
```

Run:

```bash
python generate_usm_docs.py
```

You get `USM_MANIFEST.md` with a clean section/field overview.

