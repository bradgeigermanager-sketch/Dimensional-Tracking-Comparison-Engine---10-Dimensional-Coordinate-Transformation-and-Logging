### 3. Schema‑driven test generator (pytest stubs)

`generate_usm_tests.py`:

```python
import json
from pathlib import Path

SCHEMA_PATH = Path("usm_v1_schema.json")
OUT_TEST = Path("test_usm_manifest_structure.py")


def main():
    schema = json.loads(SCHEMA_PATH.read_text())
    sections = list(schema.get("properties", {}).keys())

    lines = [
        "import json",
        "from pathlib import Path",
        "",
        "SCHEMA_PATH = Path('usm_v1_schema.json')",
        "",
        "",
        "def load_schema():",
        "    return json.loads(SCHEMA_PATH.read_text())",
        "",
        "",
        "def test_usm_has_required_sections():",
        "    schema = load_schema()",
        "    props = set(schema.get('properties', {}).keys())",
        f"    expected = {sections!r}",
        "    for sec in expected:",
        "        assert sec in props, f'Missing section: {sec}'",
        "",
    ]

    for sec in sections:
        lines.append(f"def test_section_{sec}_has_properties():")
        lines.append("    schema = load_schema()")
        lines.append(f"    sec = schema['properties']['{sec}']")
        lines.append("    assert 'properties' in sec")
        lines.append("    assert isinstance(sec['properties'], dict)")
        lines.append("    assert len(sec['properties']) > 0")
        lines.append("")

    OUT_TEST.write_text("\n".join(lines))
    print(f"Wrote {OUT_TEST}")


if __name__ == '__main__':
    main()
```

Run:

```bash
python generate_usm_tests.py
pytest -q
```

You now have:

- A visual dependency graph  
- Auto‑generated manifest docs  
- Auto‑generated structural tests tied to the schema.
